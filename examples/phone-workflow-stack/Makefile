# The phone-workflow stack: one command installs everything that the GitHub
# flow needs on a kind cluster. See README.md for the manual steps around it.
#
#   make kind-up      create the kind cluster with the Funnel port mapping
#   make check        check the Secret files and build the kustomization (no cluster)
#   make install      check, then apply the stack to KUBE_CONTEXT
#   make uninstall    delete the stack; keep the Secrets, the namespaces and the cluster

# The kube context. The default is the context of `make kind-up`.
KUBE_CONTEXT ?= kind-$(KIND_CLUSTER)
# The release that pins install.yaml and the agent images. "latest" follows
# the newest GitHub release; the stack needs v0.4.0 or later.
VERSION ?= v0.4.0

KIND_CLUSTER ?= conveyor-dev
KIND_NODE_IMAGE ?= kindest/node:v1.36.4
KIND_CONFIG ?= kind-config.yaml
KUBECTL ?= kubectl
KIND ?= kind

REPO_URL := https://github.com/openconveyor/openconveyor
ifeq ($(VERSION),latest)
INSTALL_YAML ?= $(REPO_URL)/releases/latest/download/install.yaml
else
INSTALL_YAML ?= $(REPO_URL)/releases/download/$(VERSION)/install.yaml
endif
# The agent images. Override them for a local build that you load into kind,
# for example AGENT_IMAGE_PREFIX=localhost/openconveyor AGENT_TAG=dev.
AGENT_IMAGE_PREFIX ?= ghcr.io/openconveyor
AGENT_TAG ?= $(VERSION)

RELEASE_DIR := base/release

.PHONY: help
help: ## Show the targets.
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-12s %s\n", $$1, $$2}'

# The repository Makefile downloads shellcheck into bin/ (make shellcheck).
SHELLCHECK ?= $(shell command -v shellcheck 2>/dev/null || echo ../../bin/shellcheck)

.PHONY: test
test: ## Run shellcheck and the tests of the scripts.
	$(SHELLCHECK) -x scripts/*.sh
	scripts/scripts_test.sh

.PHONY: kind-up
kind-up: ## Create the kind cluster with the port mapping for the Funnel.
	@if $(KIND) get clusters 2>/dev/null | grep -qx '$(KIND_CLUSTER)'; then \
		echo "kind cluster $(KIND_CLUSTER) exists"; \
	else \
		$(KIND) create cluster --name '$(KIND_CLUSTER)' --image '$(KIND_NODE_IMAGE)' --config '$(KIND_CONFIG)'; \
	fi

# release writes the version-dependent kustomization: the install.yaml of
# VERSION and a JSON patch that pins the image of each agent class. A local
# INSTALL_YAML is
# copied into the directory, because kustomize loads files only below the
# kustomization root.
.PHONY: release
release:
	@set -e; mkdir -p $(RELEASE_DIR); \
	case '$(INSTALL_YAML)' in \
		http://*|https://*) src='$(INSTALL_YAML)'; rm -f $(RELEASE_DIR)/install.yaml ;; \
		*) cp '$(INSTALL_YAML)' $(RELEASE_DIR)/install.yaml; src=install.yaml ;; \
	esac; \
	{ \
		echo '# Generated by make from VERSION=$(VERSION). Do not edit; git ignores it.'; \
		echo 'apiVersion: kustomize.config.k8s.io/v1beta1'; \
		echo 'kind: Kustomization'; \
		echo 'resources:'; \
		echo "  - $$src"; \
		echo '  - ../agentclasses'; \
		echo 'patches:'; \
		for a in implementer reviewer reporter; do \
			echo "  - target: {kind: ClusterAgentClass, name: claude-code-$$a}"; \
			echo "    patch: '[{\"op\": \"replace\", \"path\": \"/spec/image\", \"value\": \"$(AGENT_IMAGE_PREFIX)/agent-claude-$$a:$(AGENT_TAG)\"}]'"; \
		done; \
	} > $(RELEASE_DIR)/kustomization.yaml

.PHONY: check
check: release ## Check the Secret files and build the kustomization. Needs no cluster.
	scripts/check-secrets.sh secrets
	$(KUBECTL) kustomize overlays/kind > /dev/null
	@echo "check passed: the Secret files are valid and overlays/kind builds"

# install applies the CRDs first and waits until the API server serves them.
# A single apply of CRDs and their custom resources fails with "no matches
# for kind", because kubectl maps every object before it applies the first.
.PHONY: install
install: check ## Check, then apply the stack to KUBE_CONTEXT.
	$(KUBECTL) kustomize overlays/kind | scripts/select-kinds.sh keep CustomResourceDefinition \
		| $(KUBECTL) --context '$(KUBE_CONTEXT)' apply --server-side --force-conflicts -f -
	$(KUBECTL) --context '$(KUBE_CONTEXT)' wait --for=condition=Established --timeout=60s \
		crd/tasks.openconveyor.ai crd/clusteragentclasses.openconveyor.ai crd/clustertriggerclasses.openconveyor.ai
	$(KUBECTL) --context '$(KUBE_CONTEXT)' apply --server-side --force-conflicts -k overlays/kind
	$(KUBECTL) --context '$(KUBE_CONTEXT)' -n conveyor-system rollout status deployment/conveyor-controller-manager --timeout=120s

# uninstall keeps the Secrets and the namespaces that hold them, so the next
# install does not need the Secret files again. It never touches the Funnel
# or the kind cluster.
.PHONY: uninstall
uninstall: release ## Delete the stack; keep the Secrets, the namespaces, the Funnel and the cluster.
	$(KUBECTL) kustomize overlays/kind | scripts/select-kinds.sh drop Namespace Secret \
		| $(KUBECTL) --context '$(KUBE_CONTEXT)' delete --ignore-not-found -f -
